<resources>
    <!-- Always dark: Tonewell's grounds carry its mode and phase, so a light system theme never shows,
         and the window opens on the player's own ground instead of a white flash. -->
    <style name="Theme.tonewell" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
