{
  "name": "tonewell",
  "private": true,
  "version": "0.2.0",
  "description": "A self-contained music box for meditation and deep focus: generative drones, noise beds and binaural beats.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:audio": "node scripts/audio-check.mjs",
    "tauri": "tauri",
    "perf": "node scripts/audio-perf.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dmg": "sh scripts/make-dmg.sh",
    "release": "bash scripts/release.sh",
    "site": "vite build --config vite.site.config.ts",
    "site:og": "node scripts/site-og.mjs",
    "site:scenes": "node scripts/site-scenes.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
